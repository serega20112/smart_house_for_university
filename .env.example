# Настройки бэкенда.
#
# У каждого значения есть безопасный предел по умолчанию, кроме AUTH_TOKEN_SECRET:
# без него процесс не запускается, потому что им подписываются сессии, а выдуманный
# на лету секрет выкидывал бы всех пользователей из систем при каждом перезапуске.
# Здесь перечислены все переменные, которые читает Settings; переменная, которую тут
# написали, а Settings не знает, — ошибка, которую ловит tests/unit/config/test_env_example.py.

APP_NAME=smart-home-backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ALLOWED_ORIGINS=
# Каталог с собранным интерфейсом. Пустое значение — путь достраивается из раскладки
# рабочей копии или образа.
FRONTEND_DIST=

AUTH_TOKEN_SECRET=change-me-to-at-least-thirty-two-characters
AUTH_SESSION_LIFETIME_MINUTES=720
# Одноразовый билет, которым WebSocket открывается вместо токена сессии в адресе.
REALTIME_TICKET_TTL_SEC=30

DATABASE_URL=postgresql+asyncpg://backend:backend@localhost:5432/backend
DATABASE_ECHO=0
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SEC=1800

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=smart-home
# Сколько ждать ответа хранилища на одну команду.
REDIS_IO_TIMEOUT_SEC=5.0

BOARD_SOCKET_PORT=8001
BOARD_SOCKET_PATH=/ws/board
BOARD_COMMAND_TIMEOUT_SEC=5.0
BOARD_WATCHDOG_SEC=15.0
BOARD_PRESENCE_TTL_SEC=60
BOARD_COMMAND_RESULT_TIMEOUT_SEC=8.0
BOARD_CLAIM_TTL_SEC=120
BOARD_HANDSHAKE_TIMEOUT_SEC=10.0
BOARD_PING_INTERVAL_SEC=30
BOARD_PING_TIMEOUT_SEC=45

LANGUAGE_BOOTSTRAP_URL=
LANGUAGE_TIMEOUT_SEC=30.0
LANGUAGE_NEURAL_COMMANDS=1

LANGUAGE_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
LANGUAGE_EMBEDDING_DIMENSIONS=384
LANGUAGE_DEVICE=cpu
LANGUAGE_CONFIDENCE_THRESHOLD=0.55

TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
TELEGRAM_LINK_LIFETIME_MIN=10

AUTOMATION_CYCLE_SEC=10.0
AUTOMATION_SCENARIO_TICK_SEC=5.0
AUTOMATION_MANUAL_OVERRIDE_MINUTES=30
AUTOMATION_SUMMARY_TTL_SEC=600
AUTOMATION_SCENARIO_SUMMARY_TTL_SEC=600

SECURITY_PBKDF2_ITERATIONS=600000
SECURITY_SALT_BYTES=16
SECURITY_TOKEN_LEEWAY_SEC=0

HTTP_MAX_CONNECTIONS=20
HTTP_MAX_KEEPALIVE_CONNECTIONS=5

DEVICE_REFRESH_ATTEMPTS=3

WORKER_QUEUE_NAME=smart-home
WORKER_JOB_TIMEOUT_SEC=60
WORKER_MAX_JOBS=4
WORKER_LOOP_TIMEOUT_SEC=120
WORKER_MAX_CONCURRENT_USERS=4
WORKER_PER_USER_TIMEOUT_SEC=20
WORKER_LOCK_TTL_SEC=30
WORKER_LOCK_REFRESH_SEC=10
