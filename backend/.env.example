# Backend configuration.
# Every value has a safe default, so the file is only needed to override it.

LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./smart_home.db

# The board dials in as a WebSocket client, so the backend listens.
ESP_SERVER_HOST=0.0.0.0
ESP_SERVER_PORT=8765
ESP_SERVER_PATH=/esp
ESP_COMMAND_TIMEOUT_SEC=5.0

AUTOMATION_INTERVAL_SEC=10.0
AUTOMATION_SCENARIO_TICK_SEC=5.0
AUTOMATION_MANUAL_OVERRIDE_MINUTES=30

# Leave the token empty to keep the bot switched off.
TELEGRAM_ENABLED=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

NLP_CONFIDENCE_THRESHOLD=0.55
NLP_ALLOW_LEXICAL_FALLBACK=1
