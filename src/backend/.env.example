# Configuration of the backend.
#
# Every value has a safe default except AUTH_TOKEN_SECRET: the process refuses to
# start without it, because sessions are signed with it and a deployment that
# invents a secret on the fly signs every user out on every restart.

APP_NAME=smart-home-backend
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ALLOWED_ORIGINS=

AUTH_TOKEN_SECRET=change-me-to-at-least-thirty-two-characters
AUTH_SESSION_LIFETIME_MINUTES=720

DATABASE_URL=postgresql+asyncpg://smart_home:smart_home@localhost:5432/smart_home
DATABASE_ECHO=0
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SEC=1800

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_KEY_PREFIX=smart-home

BOARD_COMMAND_TIMEOUT_SEC=5.0
BOARD_WATCHDOG_SEC=15.0
BOARD_CLAIM_TTL_SEC=120
BOARD_RELAY_CHANNEL_COUNT=6

VOICE_ENABLED=0
VOICE_BASE_URL=http://127.0.0.1:8100
VOICE_BOOTSTRAP_URL=
VOICE_TIMEOUT_SEC=30.0
VOICE_SAMPLE_RATE=16000
VOICE_MAX_AUDIO_SEC=8
VOICE_MIN_AUDIO_BYTES=8000
VOICE_SYNTHESIS_ENABLED=1
VOICE_VAD_THRESHOLD=180
VOICE_NEURAL_COMMANDS=1

LANGUAGE_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
LANGUAGE_EMBEDDING_DIMENSIONS=384
LANGUAGE_DEVICE=cpu
LANGUAGE_CONFIDENCE_THRESHOLD=0.55

TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

AUTOMATION_AUTOMATION_CYCLE_SEC=10.0
AUTOMATION_SCENARIO_TICK_SEC=5.0
AUTOMATION_MANUAL_OVERRIDE_MINUTES=30
AUTOMATION_SCENARIO_SUMMARY_MINUTES=10
AUTOMATION_SCENARIO_SUMMARY_TTL_SEC=600