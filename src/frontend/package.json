{
  "name": "smart-home-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Веб-интерфейс умного дома (Feature-Sliced Design): климат, устройства, автоматика, сценарии, платы и команды",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:fsd": "node scripts/check-fsd.mjs",
    "check": "npm run typecheck && npm run check:fsd"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
